# .env.example: variable NAMES and placeholders only. Never commit real values.
# Copy to .env.local for local development.

# PostgreSQL connection (Supabase session pooler, port 5432). Production only.
# LEAVE EMPTY LOCALLY: the Supabase database is shared with other apps and holds
# production data. Empty means the app uses local SQLite in CSMS_DATA_DIR.
DATABASE_URL=

# Signs session cookies. Required in production: 32+ random characters.
SESSION_SECRET=replace-with-a-long-random-secret

NODE_ENV=development

# Optional: local SQLite directory (default ./data).
# CSMS_DATA_DIR=./data

# Optional: max PostgreSQL connections per app instance (default 5). Keep it low on a shared database.
# PG_POOL_MAX=5

# Optional: public origin for sitemap.xml, robots.txt and Open Graph URLs.
SITE_URL=

# Local demo accounts created by `npm run seed` (local database only).
# ADMIN_PASSWORD=
# FACULTY_PASSWORD=
# SEED_DEFAULT_USERS=1
