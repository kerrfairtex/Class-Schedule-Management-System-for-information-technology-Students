# .env.example (placeholders ONLY - no real credentials)
# Required for PostgreSQL adapter (Phase D; not yet executed)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Supabase project URL (optional for adapter-only; only needed if using Supabase client APIs)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (optional; adapter uses DATABASE_URL, not this; add ONLY if code requires Supabase client)
# SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (DO NOT ADD unless business logic requires server-side privileged Supabase access; current auth/custom session does NOT use this)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Existing session/auth variable (required in production; set via Vercel env or this file)
SESSION_SECRET=replace-with-secure-secret

# Existing environment (used by adapter for Vercel check; preserved during transition)
NODE_ENV=development

# Existing data directory reference (to be removed after adapter verified; preserved temporarily for rollback)
# CSMS_DATA_DIR=/data/csms-data
